# ========================
# PlanIT.IO — .gitignore
# ========================

# ---------- Dependencies ----------
node_modules/
.pnpm-store/

# ---------- Build Output ----------
dist/
build/
out/
*.tsbuildinfo

# ---------- Tauri / Rust ----------
target/
src-tauri/target/
*.rs.bk

# ---------- Environment ----------
.env
.env.local
.env.*.local
!.env.example

# ---------- IDE ----------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- OS ----------
.DS_Store
.Spotlight-V100
.Trashes
ehthumbs.db

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Testing ----------
coverage/
.nyc_output/
test-results/
playwright-report/

# ---------- Docker ----------
docker/volumes/

# ---------- Prisma ----------
prisma/*.db
prisma/*.db-journal

# ---------- Misc ----------
*.tgz
*.tar.gz
.turbo/
.cache/
tmp/
temp/

# Snyk Security Extension - AI Rules (auto-generated)
.agent/rules/snyk_rules.md

# Vite build artifacts
apps/desktop/vite.config.d.ts
apps/desktop/vite.config.d.ts.map
apps/desktop/vite.config.js
