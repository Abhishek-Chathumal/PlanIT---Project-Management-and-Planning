{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "**/.env.*local"
    ],
    "globalEnv": [
        "NODE_ENV"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                "build/**",
                ".next/**",
                "!.next/cache/**"
            ],
            "cache": true
        },
        "dev": {
            "dependsOn": [
                "^build"
            ],
            "persistent": true,
            "cache": false
        },
        "lint": {
            "dependsOn": [
                "^build"
            ],
            "cache": true
        },
        "lint:fix": {
            "dependsOn": [
                "^build"
            ],
            "cache": false
        },
        "test": {
            "dependsOn": [
                "^build"
            ],
            "cache": true
        },
        "test:coverage": {
            "dependsOn": [
                "^build"
            ],
            "cache": false
        },
        "clean": {
            "cache": false
        }
    }
}